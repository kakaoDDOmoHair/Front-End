[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = false
[remote "origin"]
	url = https://github.com/kakaoDDOmoHair/Frontend.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "develop"]
	remote = origin
	merge = refs/heads/develop
	vscode-merge-base = origin/develop
[branch "registration"]
	vscode-merge-base = origin/develop
[branch "schedule"]
	vscode-merge-base = origin/develop
[branch "pay"]
	vscode-merge-base = origin/develop
[branch "api"]
	vscode-merge-base = origin/develop
[branch "login"]
	vscode-merge-base = origin/develop
[branch "test"]
	vscode-merge-base = origin/develop
